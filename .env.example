SA_PASSWORD=Your_password123

# ---------- OPÇÃO A (recomendada, grátis): Groq ----------
# Chave em https://console.groq.com/keys
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=cole-sua-chave-aqui
LLM_MODEL=llama-3.3-70b-versatile

# ---------- OPÇÃO B (grátis): Google Gemini ----------
# Chave em https://aistudio.google.com/apikey
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=sua-chave-do-ai-studio
# LLM_MODEL=gemini-2.5-flash

# ---------- OPÇÃO C (grátis, local, sem chave): Ollama ----------
# Instale em https://ollama.com e rode: ollama pull llama3.1
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_API_KEY=
# LLM_MODEL=llama3.1

# ---------- Se um dia tiver API paga da Anthropic ----------
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sua-chave
# LLM_MODEL=claude-sonnet-5-5
